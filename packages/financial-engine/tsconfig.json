{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "declaration": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "types": ["jest", "node"],
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*", "tests/**/*"]
}
