# Application & Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
POSTGRES_USER=policydaily
POSTGRES_PASSWORD=policydaily_secret
POSTGRES_DB=policydaily_db
POSTGRES_PORT=5432

# Database Connection URL
# When connecting from Docker API container:
DATABASE_URL=postgresql://policydaily:policydaily_secret@postgres:5432/policydaily_db?schema=public
# When connecting from host machine (e.g. running NestJS locally or running migrations):
# DATABASE_URL=postgresql://policydaily:policydaily_secret@localhost:5432/policydaily_db?schema=public

# Document Processor Microservice (Python / FastAPI)
DOCUMENT_PROCESSOR_PORT=8000
DOCUMENT_PROCESSOR_URL=http://localhost:8000

# JWT & Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRATION=7d

# Mobile Client Configuration (Expo)
# iOS Simulator: http://localhost:3000
# Android Emulator: http://10.0.2.2:3000
# Physical Device on LAN: http://<YOUR_LOCAL_IP>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
